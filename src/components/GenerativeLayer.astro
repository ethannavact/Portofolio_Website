---
// Ranura para la capa generativa (WebGL/canvas) detrás del contenido.
// Contrato: decorativa (aria-hidden), se carga después del contenido,
// se pausa fuera de pantalla y respeta el toggle de movimiento.
// El dibujo vive en src/generative/sketch.ts — ahí entra tu dirección de arte.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['generative', className]} aria-hidden="true">
  <canvas data-generative></canvas>
</div>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-generative]');
  if (canvas) {
    const start = async () => {
      const { mount } = await import('../generative/sketch');
      mount(canvas);
    };
    if ('requestIdleCallback' in window) requestIdleCallback(() => start());
    else setTimeout(start, 200);
  }
</script>

<style>
  .generative {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  canvas {
    width: 100%;
    height: 100%;
  }
</style>
