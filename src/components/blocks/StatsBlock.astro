---
import type { Lang } from '../../i18n/routes';
import { pick } from '../../i18n/ui';

interface Props {
  lang: Lang;
  value: {
    heading: { es: string; en: string };
    items: { value: string; label: { es: string; en: string } }[];
  };
}

const { lang, value } = Astro.props;
const heading = pick(value.heading, lang);
const items = value.items.filter((i) => i.value);
---

{
  items.length > 0 && (
    <div class="wrap stats">
      {heading && <h2 class="label stats-heading">{heading}</h2>}
      <dl class="items">
        {items.map((item) => (
          <div class="item">
            <dt class="label">{pick(item.label, lang)}</dt>
            <dd class="value">{item.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  )
}

<style>
  .stats-heading {
    margin-bottom: var(--space-5);
  }

  .items {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-6) var(--gutter);
  }

  .item {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--fg);
  }

  .value {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: var(--weight-medium);
    line-height: 1;
    letter-spacing: var(--display-tracking);
    font-variant-numeric: tabular-nums;
  }

  dt {
    max-width: 28ch;
  }
</style>
