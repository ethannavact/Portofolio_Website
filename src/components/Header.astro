---
import { contactRoute, otherLang, route, HTML_LANG, type Alternates, type Lang, type RouteKey } from '../i18n/routes';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
  alternates: Alternates;
  current?: RouteKey;
  siteName: string;
}

const { lang, alternates, current, siteName } = Astro.props;
const t = ui(lang);
const alt = otherLang(lang);

const links = [
  { key: 'work', href: route('work', lang), label: t.navWork },
  { key: 'services', href: route('services', lang), label: t.navServices },
  { key: 'gallery', href: route('gallery', lang), label: t.navGallery },
  { key: 'info', href: route('info', lang), label: t.navInfo },
  { key: 'contact', href: contactRoute(lang), label: t.navContact },
] as const;
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={route('home', lang)} aria-current={current === 'home' ? 'page' : undefined}>{siteName}</a>

    <nav class="nav" aria-label={t.navLabel}>
      <ul role="list">
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="tools">
      <a class="tool" href={alternates[alt]} hreflang={HTML_LANG[alt]} lang={HTML_LANG[alt]} aria-label={t.langSwitchLabel}>
        {t.langSwitchShort}
      </a>
      <button class="tool sound" type="button" aria-pressed="false" data-sound-toggle>
        <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="tool-label">{t.sound}</span>
        <span class="sr-only">— {t.soundLabel}</span>
      </button>
      <button class="tool motion" type="button" aria-pressed="true" data-motion-toggle>
        <span class="dot" aria-hidden="true"></span>
        <span class="tool-label">{t.motionOn}</span>
        <span class="sr-only">— {t.motionLabel}</span>
      </button>
    </div>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-motion-toggle]');
  const root = document.documentElement;

  // Alto real del header (en teléfono la navegación baja a una segunda fila): lo usan
  // la ruleta y el caso para fijar sus paneles justo debajo.
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    const measure = () => root.style.setProperty('--header-real', `${header.offsetHeight}px`);
    measure();
    new ResizeObserver(measure).observe(header);
  }

  const sync = () => button?.setAttribute('aria-pressed', String(root.dataset.motion !== 'off'));
  sync();

  button?.addEventListener('click', () => {
    const next = root.dataset.motion === 'off' ? 'on' : 'off';
    root.dataset.motion = next;
    try {
      localStorage.setItem('motion', next);
    } catch {
      /* sin almacenamiento: el cambio dura esta visita */
    }
    sync();
    document.dispatchEvent(new CustomEvent('motionchange', { detail: next }));
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: var(--space-5);
    min-height: var(--header-h);
  }

  .brand {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: var(--weight-bold);
    letter-spacing: var(--display-tracking);
    text-decoration: none;
    padding-block: var(--space-3);
  }

  .nav ul {
    display: flex;
    flex-wrap: wrap;
    column-gap: clamp(var(--space-4), 2.5vw, var(--space-6));
  }

  .nav a {
    display: inline-block;
    padding-block: var(--space-3);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--label-tracking);
    text-transform: uppercase;
    text-decoration: none;
  }

  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--fg);
  }

  .nav a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.45em;
  }

  .tools {
    display: flex;
    gap: var(--space-2);
  }

  .tool {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 40px;
    min-width: 44px;
    justify-content: center;
    padding: 0 var(--space-3);
    border: var(--border);
    border-radius: var(--radius-sm);
    background: transparent;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--label-tracking);
    text-transform: uppercase;
    text-decoration: none;
    transition: border-color var(--dur-1) var(--ease-out);
  }

  .tool:hover {
    border-color: var(--fg);
  }

  .dot {
    width: 7px;
    height: 7px;
    border: 1px solid var(--fg);
    border-radius: 50%;
  }

  .motion[aria-pressed='true'] .dot {
    background: var(--fg);
  }

  /* Ecualizador del botón de sonido: quieto si está apagado. */
  .bars {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 10px;
  }

  .bars i {
    width: 2px;
    height: 4px;
    background: var(--fg);
    opacity: 0.55;
    transform-origin: bottom;
  }

  .bars i:nth-child(2) {
    height: 8px;
  }

  .bars i:nth-child(3) {
    height: 6px;
  }

  .sound[aria-pressed='true'] .bars i {
    opacity: 1;
  }

  .sound[aria-pressed='true'] .bars i {
    height: 10px;
    animation: eq 1.1s var(--ease-in-out) infinite alternate;
  }

  .sound[aria-pressed='true'] .bars i:nth-child(2) {
    animation-delay: -0.4s;
  }

  .sound[aria-pressed='true'] .bars i:nth-child(3) {
    animation-delay: -0.8s;
  }

  @keyframes eq {
    from { transform: scaleY(0.3); }
    to { transform: scaleY(1); }
  }

  /* En teléfono: la navegación baja a una segunda fila, sin menú oculto. */
  @media (max-width: 40rem) {
    .nav {
      order: 3;
      width: 100%;
      border-top: var(--border);
    }

    .tool-label {
      display: none;
    }

    .nav ul {
      justify-content: space-between;
      column-gap: var(--space-3);
    }
  }
</style>
